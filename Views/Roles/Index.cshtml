@model RolesViewModel
@using TransMetroUMG.Domain

@{
    ViewData["Title"] = "Roles";
    var editando = Model.Formulario.CodRol > 0;
}

<div class="page-heading">
    <p class="eyebrow">Seguridad / Roles</p>
    <h1>Roles</h1>
    <p>Registra roles y consulta o modifica sus datos.</p>
</div>

@if (TempData["RolGuardado"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<section class="module-card mb-4" aria-labelledby="titulo-formulario">
    <h2 id="titulo-formulario">
        @(editando ? "Editar rol" : "Ingresar rol")
    </h2>

    <form asp-controller="Roles" asp-action="Guardar"
          method="post" class="user-form">

        <div asp-validation-summary="All"
             class="text-danger" role="alert"></div>

        <input asp-for="Formulario.CodRol" type="hidden" />

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Formulario.NombreRol" class="form-label">
                    Nombre del rol *
                </label>
                <input asp-for="Formulario.NombreRol"
                       class="form-control" maxlength="100" />
                <span asp-validation-for="Formulario.NombreRol"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Formulario.Estado" class="form-label">
                    Estado *
                </label>
                <select asp-for="Formulario.Estado"
                        asp-items="Html.GetEnumSelectList<EstadoRol>()"
                        class="form-select">
                    <option value="">Selecciona un estado</option>
                </select>
                <span asp-validation-for="Formulario.Estado"
                      class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Formulario.DescripcionRol"
                       class="form-label"></label>
                <textarea asp-for="Formulario.DescripcionRol"
                          class="form-control" maxlength="250"
                          rows="3"></textarea>
                <span asp-validation-for="Formulario.DescripcionRol"
                      class="text-danger"></span>
            </div>
        </div>

        <p class="form-text mt-3">
            Los campos marcados con * son obligatorios.
        </p>

        <div class="d-flex flex-wrap gap-3 mt-3">
            <button class="btn btn-primary" type="submit">
                @(editando ? "Guardar cambios" : "Registrar rol")
            </button>

            @if (editando)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar edición
                </a>
            }

            <a asp-controller="Home" asp-action="Index"
               asp-fragment="seguridad" class="btn btn-outline-secondary">
                Volver al menú
            </a>
        </div>
    </form>
</section>

<section class="module-card" aria-labelledby="titulo-tabla">
    <h2 id="titulo-tabla">Roles registrados</h2>

    @if (Model.ErrorCarga)
    {
        <div class="alert alert-danger" role="alert">
            No se pudo consultar el listado.
            <a asp-action="Index">Reintentar</a>
        </div>
    }
    else if (Model.Registros.Count == 0)
    {
        <p role="status">
            No hay roles registrados. Ingresa el primero en el formulario.
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <caption>@Model.Registros.Count roles registrados.</caption>
                <thead>
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rol in Model.Registros)
                    {
                        <tr>
                            <td>@rol.CodRol</td>
                            <td>@rol.NombreRol</td>
                            <td>@rol.DescripcionRol</td>
                            <td>@rol.Estado</td>
                            <td>
                                <a asp-action="Index"
                                   asp-route-id="@rol.CodRol"
                                   class="btn btn-sm btn-outline-secondary"
                                   aria-label="Editar @rol.NombreRol">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
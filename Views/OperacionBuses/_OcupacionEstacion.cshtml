@model OperacionBusesViewModel
@{ var datos = Model.Ocupacion; }

@if (TempData["OcupacionGuardada"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
<section class="module-card mb-4" aria-labelledby="titulo-estacion">
    <h2 id="titulo-estacion">Estación</h2>
    <p>Consulta la última estimación y el historial de pasajeros en la estación.</p>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <form asp-action="Index" method="get" class="user-form">
        <input type="hidden" name="Fecha" value="@(Model.Fecha?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="CodigoLinea" value="@Model.CodigoLinea" />
        <div class="row g-3">
            <div class="col-12">
                <label for="estacion" class="form-label">Estación</label>
                <select id="estacion" name="estacion" class="form-select">
                    <option value="">Selecciona una estación</option>
                    @foreach (var estacion in datos.Estaciones)
                    {
                        <option value="@estacion.Codigo" selected="@(estacion.Codigo == datos.CodEstacion)">@estacion.Municipalidad / @estacion.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Consultar estación</button>
    </form>
    @if (datos.ErrorCarga)
    {
        <div class="alert alert-danger mt-3" role="alert">No se pudo consultar la ocupación. Intenta nuevamente.</div>
    }
    else if (datos.Seleccionada is { } seleccionada)
    {
        <div class="row g-3 mt-2">
            <div class="col-md-6"><strong>Capacidad máxima:</strong> @(seleccionada.Capacidad?.ToString() ?? "Pendiente de configurar")</div>
            <div class="col-md-6"><strong>Última medición:</strong><partial name="_TiempoMedicion" model="@(new TiempoMedicionViewModel(datos.Ultima?.Fecha, Model.HoraReferencia))" /></div>
        </div>
        @if (datos.Ultima is { } ultima)
        {
            <p class="mt-3">@ultima.Pasajeros pasajeros · @ultima.Porcentaje.ToString("0.##") % de ocupación sobre la capacidad máxima de @ultima.Capacidad.</p>
            @if (ultima.RequiereApoyo)
            {
                <partial name="_AlertaCapacidadEstacion" model="ultima" />
            }
            else
            {
                <p role="status">La última estimación está por debajo del umbral de alerta del 150 %.</p>
            }
        }
        @if (seleccionada.Capacidad is null or <= 0)
        {
            <div class="alert alert-info mt-3" role="status">La estación no tiene una capacidad máxima configurada.
            </div>
        }
    }
</section>

@if (!datos.ErrorCarga && datos.Seleccionada is not null)
{
    <section class="module-card mb-4" aria-labelledby="titulo-historial-estacion">
        <h2 id="titulo-historial-estacion">Historial de ocupación de la estación</h2>
        @if (datos.Historial.Count == 0)
        {
            <p role="status">No hay mediciones en esta página.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <caption>Mediciones de @datos.Seleccionada.Nombre. Página @datos.Pagina, hasta 20 registros por página.</caption>
                    <thead><tr>
                        <th scope="col">Fecha y hora</th><th scope="col">Pasajeros</th>
                        <th scope="col">Capacidad máxima</th><th scope="col">Ocupación</th>
                        <th scope="col">Resultado</th><th scope="col">Operador</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var registro in datos.Historial)
                        {
                            <tr>
                                <td>@registro.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>@registro.Pasajeros</td><td>@registro.Capacidad</td>
                                <td>@registro.Porcentaje.ToString("0.##") %</td>
                                <td>@(registro.RequiereApoyo ? "Alerta: se requiere otro bus" : "Por debajo del umbral de alerta")</td>
                                <td>@registro.Operador</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <nav class="d-flex flex-wrap gap-3 mt-3" aria-label="Páginas del historial de ocupación">
            @if (datos.Pagina > 1)
            {
                <a asp-action="Index" asp-route-estacion="@datos.CodEstacion" asp-route-pagina="@(datos.Pagina - 1)" asp-route-fecha="@(Model.Fecha?.ToString("yyyy-MM-dd"))" asp-route-codigoLinea="@Model.CodigoLinea" class="btn btn-outline-secondary">Anterior</a>
            }
            @if (datos.HaySiguiente)
            {
                <a asp-action="Index" asp-route-estacion="@datos.CodEstacion" asp-route-pagina="@(datos.Pagina + 1)" asp-route-fecha="@(Model.Fecha?.ToString("yyyy-MM-dd"))" asp-route-codigoLinea="@Model.CodigoLinea" class="btn btn-outline-secondary">Siguiente</a>
            }
        </nav>
    </section>
}

@model BusesViewModel
@using TransMetroUMG.Domain
@{
    ViewData["Title"] = "Buses";
    var editando = Model.Formulario.CodBus > 0;
    var municipalidades = Model.Municipalidades.ToDictionary(x => x.Codigo, x => x.Nombre);
}

<div class="page-heading">
    <p class="eyebrow">Buses y pilotos / Buses</p>
    <h1>Buses</h1>
    <p>Registra buses y consulta o modifica sus datos.</p>
</div>

@if (TempData["BusGuardado"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<section class="module-card mb-4" aria-labelledby="titulo-formulario">
    <h2 id="titulo-formulario">@(editando ? "Editar bus" : "Ingresar bus")</h2>
    <form asp-action="Guardar" method="post" class="user-form">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="Formulario.CodBus" type="hidden" />
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Formulario.CodMunicipalidad" class="form-label">Municipalidad *</label>
                <select asp-for="Formulario.CodMunicipalidad" class="form-select">
                    <option value="">Selecciona una municipalidad</option>
                    @foreach (var municipalidad in Model.Municipalidades)
                    {
                        <option value="@municipalidad.Codigo">@municipalidad.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Formulario.CodMunicipalidad" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Formulario.Estado" class="form-label">Estado *</label>
                <select asp-for="Formulario.Estado" asp-items="Html.GetEnumSelectList<EstadoBus>()" class="form-select">
                    <option value="">Selecciona un estado</option>
                </select>
                <span asp-validation-for="Formulario.Estado" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Formulario.NumeroBus" class="form-label">Número del bus *</label>
                <input asp-for="Formulario.NumeroBus" class="form-control" maxlength="30" />
                <span asp-validation-for="Formulario.NumeroBus" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Formulario.NumeroPlaca" class="form-label">Placa *</label>
                <input asp-for="Formulario.NumeroPlaca" class="form-control" maxlength="20" />
                <span asp-validation-for="Formulario.NumeroPlaca" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Formulario.CapacidadPasajeros" class="form-label">Capacidad de pasajeros *</label>
                <input asp-for="Formulario.CapacidadPasajeros" class="form-control" type="number" min="1" step="1" />
                <span asp-validation-for="Formulario.CapacidadPasajeros" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Formulario.ModeloBus" class="form-label"></label>
                <input asp-for="Formulario.ModeloBus" class="form-control" maxlength="100" />
                <span asp-validation-for="Formulario.ModeloBus" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Formulario.AnioBus" class="form-label"></label>
                <input asp-for="Formulario.AnioBus" class="form-control" type="number" step="1" />
                <span asp-validation-for="Formulario.AnioBus" class="text-danger"></span>
            </div>
        </div>
        <p class="form-text mt-3">Los campos marcados con * son obligatorios.</p>
        <div class="d-flex flex-wrap gap-3 mt-3">
            <button type="submit" class="btn btn-primary">@(editando ? "Guardar cambios" : "Registrar bus")</button>
            @if (editando)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar edición</a>
            }
            <a asp-controller="Home" asp-action="Index" asp-fragment="transporte" class="btn btn-outline-secondary">Volver al menú</a>
        </div>
    </form>
</section>

<section class="module-card" aria-labelledby="titulo-tabla">
    <h2 id="titulo-tabla">Buses registrados</h2>
    @if (Model.ErrorCarga)
    {
        <div class="alert alert-danger" role="alert">
            No se pudo consultar el listado. <a asp-action="Index">Reintentar</a>
        </div>
    }
    else if (Model.Registros.Count == 0)
    {
        <p role="status">No hay buses registrados. Ingresa el primero en el formulario.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <caption>@Model.Registros.Count buses registrados.</caption>
                <thead>
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Municipalidad</th>
                        <th scope="col">Número</th>
                        <th scope="col">Placa</th>
                        <th scope="col">Capacidad</th>
                        <th scope="col">Modelo</th>
                        <th scope="col">Año</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bus in Model.Registros)
                    {
                        <tr>
                            <td>@bus.CodBus</td>
                            <td>@municipalidades.GetValueOrDefault(bus.CodMunicipalidad, bus.CodMunicipalidad.ToString())</td>
                            <td>@bus.NumeroBus</td>
                            <td>@bus.NumeroPlaca</td>
                            <td>@bus.CapacidadPasajeros</td>
                            <td>@bus.ModeloBus</td>
                            <td>@bus.AnioBus</td>
                            <td>@bus.Estado</td>
                            <td>
                                <a asp-action="Index" asp-route-id="@bus.CodBus"
                                   class="btn btn-sm btn-outline-secondary" aria-label="Editar bus @bus.NumeroBus">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


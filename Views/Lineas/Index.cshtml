@model LineasViewModel
@using TransMetroUMG.Domain
@{
    ViewData["Title"] = "Líneas";
    var editando = Model.Formulario.CodLinea > 0;
    var municipalidades = Model.Municipalidades.ToDictionary(x => x.Codigo, x => x.Nombre);
}

<div class="page-heading">
    <p class="eyebrow">Administración / Líneas</p>
    <h1>Líneas</h1>
    <p>Registra líneas y consulta o modifica sus datos.</p>
</div>

@if (TempData["LineaGuardada"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<section class="module-card mb-4" aria-labelledby="titulo-formulario">
    <h2 id="titulo-formulario">@(editando ? "Editar línea" : "Ingresar línea")</h2>
    <form asp-action="Guardar" method="post" class="user-form">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="Formulario.CodLinea" type="hidden" />
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Formulario.CodMunicipalidad" class="form-label">Municipalidad *</label>
                <select asp-for="Formulario.CodMunicipalidad" class="form-select">
                    <option value="">Selecciona una municipalidad</option>
                    @foreach (var municipalidad in Model.Municipalidades)
                    {
                        <option value="@municipalidad.Codigo">@municipalidad.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Formulario.CodMunicipalidad" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Formulario.Estado" class="form-label">Estado *</label>
                <select asp-for="Formulario.Estado" asp-items="Html.GetEnumSelectList<EstadoLinea>()" class="form-select">
                    <option value="">Selecciona un estado</option>
                </select>
                <span asp-validation-for="Formulario.Estado" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Formulario.NombreLinea" class="form-label">Nombre de la línea *</label>
                <input asp-for="Formulario.NombreLinea" class="form-control" maxlength="100" />
                <span asp-validation-for="Formulario.NombreLinea" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Formulario.DescripcionLinea" class="form-label"></label>
                <textarea asp-for="Formulario.DescripcionLinea" class="form-control" maxlength="250" rows="3"></textarea>
                <span asp-validation-for="Formulario.DescripcionLinea" class="text-danger"></span>
            </div>
        </div>
        <p class="form-text mt-3">Los campos marcados con * son obligatorios.</p>
        <div class="d-flex flex-wrap gap-3 mt-3">
            <button type="submit" class="btn btn-primary">@(editando ? "Guardar cambios" : "Registrar línea")</button>
            @if (editando)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar edición</a>
            }
            <a asp-controller="Home" asp-action="Index" asp-fragment="administracion" class="btn btn-outline-secondary">Volver al menú</a>
        </div>
    </form>
</section>

<section class="module-card" aria-labelledby="titulo-tabla">
    <h2 id="titulo-tabla">Líneas registradas</h2>
    @if (Model.ErrorCarga)
    {
        <div class="alert alert-danger" role="alert">
            No se pudo consultar el listado. <a asp-action="Index">Reintentar</a>
        </div>
    }
    else if (Model.Registros.Count == 0)
    {
        <p role="status">No hay líneas registradas. Ingresa la primera en el formulario.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <caption>@Model.Registros.Count líneas registradas.</caption>
                <thead>
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Municipalidad</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in Model.Registros)
                    {
                        <tr>
                            <td>@linea.CodLinea</td>
                            <td>@municipalidades.GetValueOrDefault(linea.CodMunicipalidad, linea.CodMunicipalidad.ToString())</td>
                            <td>@linea.NombreLinea</td>
                            <td>@linea.DescripcionLinea</td>
                            <td>@linea.Estado</td>
                            <td><a asp-action="Index" asp-route-id="@linea.CodLinea"
                                   class="btn btn-sm btn-outline-secondary" aria-label="Editar @linea.NombreLinea">Editar</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

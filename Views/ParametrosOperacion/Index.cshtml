@model ParametrosOperacionViewModel
@{
    ViewData["Title"] = "Parámetros de operación";
    var editando = Model.Formulario.CodParametroOperacion > 0;
}

<div class="page-heading">
    <p class="eyebrow">Operaciones / Parámetros</p>
    <h1>Parámetros de operación</h1>
    <p>Registra parámetros y consulta o modifica sus valores.</p>
</div>

@if (TempData["ParametroGuardado"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<section class="module-card mb-4" aria-labelledby="titulo-formulario">
    <h2 id="titulo-formulario">@(editando ? "Editar parámetro" : "Ingrese parámetro")</h2>
    <form asp-action="Guardar" method="post" class="user-form">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="Formulario.CodParametroOperacion" type="hidden" />
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Formulario.Clave" class="form-label">Clave *</label>
                <input asp-for="Formulario.Clave" class="form-control" maxlength="100" />
                <span asp-validation-for="Formulario.Clave" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Formulario.Valor" class="form-label">Valor</label>
                <input asp-for="Formulario.Valor" class="form-control" type="number" step="0.0001"
                       aria-describedby="ayuda-valor" />
                <span asp-validation-for="Formulario.Valor" class="text-danger"></span>
                <div id="ayuda-valor" class="form-text"> </div>
            </div>
            <div class="col-12">
                <label asp-for="Formulario.Descripcion" class="form-label">Descripción *</label>
                <textarea asp-for="Formulario.Descripcion" class="form-control" maxlength="250" rows="3"></textarea>
                <span asp-validation-for="Formulario.Descripcion" class="text-danger"></span>
            </div>
        </div>
        <p class="form-text mt-3">Los campos marcados con * son obligatorios.</p>
        <div class="d-flex flex-wrap gap-3 mt-3">
            <button class="btn btn-primary" type="submit">@(editando ? "Guardar cambios" : "Registrar parámetro")</button>
            @if (editando)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar edición</a>
            }
            <a asp-controller="Home" asp-action="Index" asp-fragment="operaciones"
               class="btn btn-outline-secondary">Volver al menú</a>
        </div>
    </form>
</section>

<section class="module-card" aria-labelledby="titulo-tabla">
    <h2 id="titulo-tabla">Parámetros registrados</h2>
    @if (Model.ErrorCarga)
    {
        <div class="alert alert-danger" role="alert">
            No se pudo consultar el listado. <a asp-action="Index">Reintentar</a>
        </div>
    }
    else if (Model.Registros.Count == 0)
    {
        <p role="status">No hay parámetros registrados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <caption>@Model.Registros.Count parámetros registrados.</caption>
                <thead>
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Clave</th>
                        <th scope="col">Valor</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Registros)
                    {
                        <tr>
                            <td>@item.CodParametroOperacion</td>
                            <td>@item.Clave</td>
                            <td>@(item.Valor.HasValue ? item.Valor.Value.ToString("0.####") : "No configurado")</td>
                            <td>@item.Descripcion</td>
                            <td>
                                <a asp-action="Index" asp-route-id="@item.CodParametroOperacion"
                                   class="btn btn-sm btn-outline-secondary" aria-label="Editar @item.Clave">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model MunicipalidadesViewModel
@{
    ViewData["Title"] = "Municipalidades";
    var editando = Model.Formulario.CodMunicipalidad > 0;
}

<div class="page-heading">
    <p class="eyebrow">Administración / Municipalidades</p>
    <h1>Municipalidades</h1>
    <p>Registra municipalidades y consulta o modifica sus datos.</p>
</div>

@if (TempData["MunicipalidadGuardada"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<section class="module-card mb-4" aria-labelledby="titulo-formulario">
    <h2 id="titulo-formulario">@(editando ? "Editar municipalidad" : "Ingresar municipalidad")</h2>
    <form asp-action="Guardar" method="post" class="user-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <input asp-for="Formulario.CodMunicipalidad" type="hidden" />
        <input asp-for="Buscar" type="hidden" />
        <input asp-for="Pagina" type="hidden" />
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Formulario.NombreMunicipalidad" class="form-label">Nombre de la municipalidad *</label>
                <input asp-for="Formulario.NombreMunicipalidad" class="form-control" maxlength="150" />
                <span asp-validation-for="Formulario.NombreMunicipalidad" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Formulario.Estado" class="form-label">Estado *</label>
                <select asp-for="Formulario.Estado" class="form-select">
                    <option value="1">Activo</option><option value="0">Inactivo</option>
                </select>
                <span asp-validation-for="Formulario.Estado" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Formulario.DireccionMunicipalidad" class="form-label"></label>
                <input asp-for="Formulario.DireccionMunicipalidad" class="form-control" maxlength="250" autocomplete="street-address" />
                <span asp-validation-for="Formulario.DireccionMunicipalidad" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Formulario.TelefonoMunicipalidad" class="form-label"></label>
                <input asp-for="Formulario.TelefonoMunicipalidad" type="tel" class="form-control" maxlength="20" autocomplete="tel" />
                <span asp-validation-for="Formulario.TelefonoMunicipalidad" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Formulario.CorreoElectronico" class="form-label"></label>
                <input asp-for="Formulario.CorreoElectronico" type="email" class="form-control" maxlength="150" autocomplete="email" />
                <span asp-validation-for="Formulario.CorreoElectronico" class="text-danger"></span>
            </div>
        </div>
        <p class="form-text mt-3">Los campos marcados con * son obligatorios.</p>
        <div class="d-flex flex-wrap gap-3 mt-3">
            <button class="btn btn-primary" type="submit">@(editando ? "Guardar cambios" : "Registrar municipalidad")</button>
            @if (editando)
            {
                <a asp-action="Index" asp-route-buscar="@Model.Buscar" asp-route-pagina="@Model.Pagina" class="btn btn-outline-secondary">Cancelar edición</a>
            }
            <a asp-controller="Home" asp-action="Index" asp-fragment="administracion" class="btn btn-outline-secondary">Volver al menú</a>
        </div>
    </form>
</section>

<section class="module-card" aria-labelledby="titulo-tabla">
    <h2 id="titulo-tabla">Municipalidades registradas</h2>
    <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-2 my-3">
        <div>
            <label for="buscar-municipalidad" class="form-label">Buscar por nombre</label>
            <input id="buscar-municipalidad" name="buscar" value="@Model.Buscar" class="form-control" maxlength="150" type="search" />
        </div>
        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </form>
    @if (Model.ErrorCarga)
    {
        <div class="alert alert-danger" role="alert">No se pudo consultar el listado. <a asp-action="Index">Reintentar</a></div>
    }
    else if (Model.Registros.Count == 0)
    {
        <p role="status">@(string.IsNullOrWhiteSpace(Model.Buscar) ? "No hay municipalidades registradas. Ingresa la primera en el formulario." : "No se encontraron municipalidades con ese nombre.")</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <caption>@Model.Total registros. Página @Model.Pagina de @Model.TotalPaginas.</caption>
                <thead><tr><th scope="col">Código</th><th scope="col">Nombre</th><th scope="col">Dirección</th><th scope="col">Teléfono</th><th scope="col">Correo</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var registro in Model.Registros)
                    {
                        <tr>
                            <td>@registro.CodMunicipalidad</td><td>@registro.NombreMunicipalidad</td>
                            <td>@registro.DireccionMunicipalidad</td><td>@registro.TelefonoMunicipalidad</td><td>@registro.CorreoElectronico</td>
                            <td>@(registro.Estado == TransMetroUMG.Domain.EstadoMunicipalidad.Activo ? "Activo" : "Inactivo")</td>
                            <td><a asp-action="Index" asp-route-id="@registro.CodMunicipalidad" asp-route-buscar="@Model.Buscar" asp-route-pagina="@Model.Pagina" class="btn btn-sm btn-outline-secondary" aria-label="Editar @registro.NombreMunicipalidad">Editar</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="d-flex gap-3" aria-label="Páginas de municipalidades">
            @if (Model.Pagina > 1)
            {
                <a asp-action="Index" asp-route-buscar="@Model.Buscar" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
            }
            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a asp-action="Index" asp-route-buscar="@Model.Buscar" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
            }
        </nav>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
